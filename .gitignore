# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local dev data
/.data/

# other projects
/neurovision/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SST native shell — generated platform projects
sst-native/node_modules/
sst-native/ios/
sst-native/android/
# www/ is generated EXCEPT error.html — the bundled offline/error fallback
# (server.errorPath) is source, not build output; losing it regresses the
# 2.1(a) blank-white-screen fix.
sst-native/www/*
!sst-native/www/error.html

# SST watch — xcodegen output + build artifacts
sst-watch/SSTWatch.xcodeproj/
sst-watch/build/
sst-watch/DerivedData/
sst-watch/Sources/Info.plist

# Local dev smoke-test / screenshot scripts (read .env.local, not for CI)
.runtime.mjs
bcap.mjs
